{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "frontend typecheck",
			"type": "shell",
			"command": "npm run typecheck --silent",
			"group": "build"
		},
		{
			"label": "frontend build",
			"type": "shell",
			"command": "npm run build --silent",
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "start-frontend-dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"start:dev"
			],
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		}
	]
}